{% comment %}
  ═══════════════════════════════════════════════════════
  Valentine Hero — valentine-hero.liquid
  ORA Valentine's Special | Shopify OS 2.0
  
  Full-viewport cinematic hero with video/image,
  gradient overlay, staggered entrance, shimmer.
  ═══════════════════════════════════════════════════════
{% endcomment %}

{%- style -%}
  .valentine-hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
  }
  .valentine-hero__media {
    position: absolute;
    inset: 0;
  }
  .valentine-hero__video,
  .valentine-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .valentine-hero__video {
    animation: ora-slow-zoom 20s ease-in-out infinite alternate;
  }
  .valentine-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(26,26,26,0.75) 0%, rgba(26,26,26,0.35) 40%, rgba(190,18,60,0.08) 100%);
  }
  .valentine-hero__overlay-bottom {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26,26,26,0.6) 0%, transparent 40%);
  }
  .valentine-hero__shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.03) 50%, transparent 100%);
    background-size: 200% 100%;
    animation: ora-shimmer 6s ease-in-out infinite;
  }
  .valentine-hero__content {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .valentine-hero__inner {
    max-width: 42rem;
  }
  .valentine-hero__tag {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: ora-fade-in-up 0.6s 0.2s ease-out forwards;
  }
  .valentine-hero__tag-line {
    width: 2.5rem;
    height: 1px;
    background: #FDA4AF;
  }
  .valentine-hero__tag-text {
    font-size: 0.875rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #FDA4AF;
    font-weight: 500;
  }
  .valentine-hero__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 300;
    line-height: 1.05;
    color: #fff;
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: ora-fade-in-up 0.7s 0.3s ease-out forwards;
  }
  .valentine-hero__title em {
    font-style: italic;
    color: #FDA4AF;
  }
  .valentine-hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(255,255,255,0.8);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 32rem;
    font-weight: 300;
    opacity: 0;
    animation: ora-fade-in-up 0.6s 0.45s ease-out forwards;
  }
  .valentine-hero__ctas {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    opacity: 0;
    animation: ora-fade-in-up 0.6s 0.6s ease-out forwards;
  }
  @media (min-width: 640px) {
    .valentine-hero__content { padding: 0 2rem; }
    .valentine-hero__ctas { flex-direction: row; }
  }
  .valentine-hero__cta-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: #BE123C;
    color: #fff;
    font-weight: 500;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(190,18,60,0.3);
  }
  .valentine-hero__cta-primary:hover {
    background: #9F1239;
    transform: scale(1.02);
  }
  .valentine-hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border: 2px solid rgba(255,255,255,0.3);
    color: #fff;
    font-weight: 500;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s ease;
    backdrop-filter: blur(8px);
  }
  .valentine-hero__cta-secondary:hover {
    border-color: rgba(255,255,255,0.6);
    background: rgba(255,255,255,0.1);
  }
  .valentine-hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    text-align: center;
    opacity: 0;
    animation: ora-fade-in 0.8s 1.2s ease-out forwards;
  }
  .valentine-hero__scroll-text {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 0.5rem;
  }
  .valentine-hero__scroll-arrow {
    animation: ora-bounce 2s ease-in-out infinite;
    color: #FDA4AF;
  }
  /* Mobile hero image swap */
  .valentine-hero__image--desktop { display: block; }
  .valentine-hero__image--mobile { display: none; }
  @media (max-width: 768px) {
    .valentine-hero__image--desktop { display: none; }
    .valentine-hero__image--mobile { display: block; }
  }
  /* Keyframes */
  @keyframes ora-slow-zoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.08); }
  }
  @keyframes ora-shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }
  @keyframes ora-fade-in-up {
    0% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes ora-fade-in {
    0% { opacity: 0; }
    100% { opacity: 0.7; }
  }
  @keyframes ora-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }
{%- endstyle -%}

<section class="valentine-hero" data-section-id="{{ section.id }}">
  <div class="valentine-hero__media">
    {%- if section.settings.video != blank -%}
      <video
        class="valentine-hero__video"
        autoplay muted loop playsinline
        preload="auto"
        poster="{{ section.settings.hero_image_desktop | image_url: width: 1920 }}"
      >
        <source src="{{ section.settings.video }}" type="video/mp4">
      </video>
    {%- endif -%}

    {%- if section.settings.hero_image_desktop != blank -%}
      <img
        class="valentine-hero__image valentine-hero__image--desktop"
        src="{{ section.settings.hero_image_desktop | image_url: width: 1920 }}"
        alt="{{ section.settings.headline | default: 'Valentine Special — ORA' }}"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
      >
    {%- endif -%}

    {%- if section.settings.hero_image_mobile != blank -%}
      <img
        class="valentine-hero__image valentine-hero__image--mobile"
        src="{{ section.settings.hero_image_mobile | image_url: width: 828 }}"
        alt="{{ section.settings.headline | default: 'Valentine Special — ORA' }}"
        loading="eager"
        fetchpriority="high"
        width="828"
        height="1472"
      >
    {%- endif -%}

    <div class="valentine-hero__overlay"></div>
    <div class="valentine-hero__overlay-bottom"></div>
    <div class="valentine-hero__shimmer"></div>
  </div>

  <div class="valentine-hero__content">
    <div class="valentine-hero__inner">
      <div class="valentine-hero__tag">
        <span class="valentine-hero__tag-line"></span>
        <span class="valentine-hero__tag-text">Valentine's 2026</span>
      </div>

      <h1 class="valentine-hero__title">
        {{ section.settings.headline | default: "Valentine's" }}
        <br>
        <em>{{ section.settings.headline_accent | default: "Special" }}</em>
      </h1>

      <p class="valentine-hero__subtitle">
        {{ section.settings.subheadline | default: "Love, styled daily — gifts that speak without words." }}
      </p>

      <div class="valentine-hero__ctas">
        {%- if section.settings.primary_cta_label != blank -%}
          <a href="{{ section.settings.primary_cta_link }}" class="valentine-hero__cta-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            <span>{{ section.settings.primary_cta_label }}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_cta_label != blank -%}
          <a href="{{ section.settings.secondary_cta_link }}" class="valentine-hero__cta-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="14" rx="2"></rect><path d="M12 8V4a2 2 0 0 1 4 0v4M8 8V4a2 2 0 0 1 4 0"></path></svg>
            <span>{{ section.settings.secondary_cta_label }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="valentine-hero__scroll">
    <div class="valentine-hero__scroll-text">Discover</div>
    <div class="valentine-hero__scroll-arrow">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Valentine Hero",
  "tag": "section",
  "class": "valentine-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image_desktop",
      "label": "Hero Image (Desktop)"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero Image (Mobile)"
    },
    {
      "type": "url",
      "id": "video",
      "label": "Hero Video URL (MP4)"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Valentine's"
    },
    {
      "type": "text",
      "id": "headline_accent",
      "label": "Headline Accent (Italic)",
      "default": "Special"
    },
    {
      "type": "textarea",
      "id": "subheadline",
      "label": "Subheadline",
      "default": "Love, styled daily — gifts that speak without words."
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary CTA Label",
      "default": "Shop Valentine Gifts"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary CTA Link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary CTA Label",
      "default": "Explore Combos"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Valentine Hero",
      "category": "Valentine's Special"
    }
  ]
}
{% endschema %}
