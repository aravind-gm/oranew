# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/ora?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/ora?schema=public"

# ── Auth / JWT ────────────────────────────────────────────
JWT_SECRET="generate-a-64-char-random-string"
JWT_EXPIRES_IN="24h"
ADMIN_PASSWORD="set-a-strong-admin-password-min-8-chars"

# ── Razorpay ──────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ── Cloudflare R2 Storage ─────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY="your-r2-access-key-id"
R2_SECRET_KEY="your-r2-secret-access-key"
R2_BUCKET="ora-images"
R2_PUBLIC_BASE_URL="https://cdn.orashop.in"

# ── Email (Gmail SMTP) ───────────────────────────────────
GMAIL_USER="admin@orashop.in"
GMAIL_APP_PASSWORD="your-gmail-app-password"
FROM_EMAIL="admin@orashop.in"
FROM_NAME="ORA Jewellery"

# ── Redis (for BullMQ job queue) ──────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
