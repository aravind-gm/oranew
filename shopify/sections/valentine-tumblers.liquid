{% comment %}
  ═══════════════════════════════════════════════════════
  Valentine Tumblers — valentine-tumblers.liquid
  ORA Valentine's Special | Shopify OS 2.0
  
  3 fixed price tiers — shows products or Coming Soon
  ═══════════════════════════════════════════════════════
{% endcomment %}

{%- style -%}
  .valentine-tumblers {
    padding: 4rem 1.25rem 5rem;
    background: #FAFAFA;
  }
  @media (min-width: 640px) {
    .valentine-tumblers { padding: 5rem 2rem; }
  }
  .valentine-tumblers__inner {
    max-width: 80rem;
    margin: 0 auto;
  }
  .valentine-tumblers__header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .valentine-tumblers__label {
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #E11D48;
    font-weight: 500;
  }
  .valentine-tumblers__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.875rem, 4vw, 3rem);
    color: #171717;
    margin-top: 0.75rem;
    font-weight: 300;
  }
  .valentine-tumblers__subtitle {
    color: #737373;
    margin-top: 1rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  .valentine-tumblers__tier {
    margin-bottom: 3.5rem;
  }
  .valentine-tumblers__tier:last-child {
    margin-bottom: 0;
  }
  .valentine-tumblers__tier-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .valentine-tumblers__tier-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #FFF5F7, #FCE7F3);
    color: #E11D48;
  }
  .valentine-tumblers__tier-label {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    color: #171717;
  }
  .valentine-tumblers__tier-tag {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #A3A3A3;
    margin-left: 0.5rem;
  }
  .valentine-tumblers__tier-line {
    flex: 1;
    height: 1px;
    background: #E5E5E5;
  }
  .valentine-tumblers__product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .valentine-tumblers__product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .valentine-tumblers__product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .valentine-tumblers__coming-soon {
    text-align: center;
    padding: 3.5rem 2rem;
    background: linear-gradient(135deg, #FFF5F7, #FCE7F3);
    border-radius: 1rem;
    border: 1px dashed #FECDD3;
  }
  .valentine-tumblers__coming-soon-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: rgba(255,255,255,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.75rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    color: #E11D48;
  }
  .valentine-tumblers__coming-soon-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.25rem;
    font-style: italic;
    color: #BE123C;
  }
  .valentine-tumblers__coming-soon-text {
    color: #A3A3A3;
    font-size: 0.875rem;
    max-width: 20rem;
    margin: 0.5rem auto 0;
  }
  .valentine-tumblers__cta {
    text-align: center;
    margin-top: 3rem;
  }
  .valentine-tumblers__cta a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    background: #171717;
    color: #fff;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .valentine-tumblers__cta a:hover {
    background: #404040;
    transform: scale(1.02);
  }
{%- endstyle -%}

<section class="valentine-tumblers" id="tumblers" data-section-id="{{ section.id }}">
  <div class="valentine-tumblers__inner">
    <div class="valentine-tumblers__header">
      <span class="valentine-tumblers__label">New This Valentine's</span>
      <h2 class="valentine-tumblers__title">{{ section.settings.title | default: "Valentine Tumblers" }}</h2>
      <p class="valentine-tumblers__subtitle">{{ section.settings.subtitle | default: "Premium drinkware — a daily reminder of love." }}</p>
    </div>

    {%- for block in section.blocks -%}
      <div class="valentine-tumblers__tier" {{ block.shopify_attributes }}>
        <div class="valentine-tumblers__tier-header">
          <div class="valentine-tumblers__tier-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2h8l2 18H6L8 2z"></path><path d="M6 6h12"></path></svg>
          </div>
          <span class="valentine-tumblers__tier-label">{{ block.settings.price_label }}</span>
          <span class="valentine-tumblers__tier-tag">{{ block.settings.tag }}</span>
          <div class="valentine-tumblers__tier-line"></div>
        </div>

        {%- if block.settings.collection != blank -%}
          {%- assign tier_collection = collections[block.settings.collection] -%}
          {%- if tier_collection.products.size > 0 -%}
            <div class="valentine-tumblers__product-grid">
              {%- for product in tier_collection.products limit: 4 -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="valentine-tumblers__coming-soon">
              <div class="valentine-tumblers__coming-soon-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2h8l2 18H6L8 2z"></path><path d="M6 6h12"></path></svg>
              </div>
              <p class="valentine-tumblers__coming-soon-title">Coming Soon</p>
              <p class="valentine-tumblers__coming-soon-text">Tumblers at {{ block.settings.price_label }} are being crafted with love.</p>
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="valentine-tumblers__coming-soon">
            <div class="valentine-tumblers__coming-soon-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2h8l2 18H6L8 2z"></path><path d="M6 6h12"></path></svg>
            </div>
            <p class="valentine-tumblers__coming-soon-title">Coming Soon</p>
            <p class="valentine-tumblers__coming-soon-text">Tumblers at {{ block.settings.price_label }} are being crafted with love.</p>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}

    <div class="valentine-tumblers__cta">
      <a href="{{ section.settings.cta_link | default: '/collections/valentine-drinkware' }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2h8l2 18H6L8 2z"></path><path d="M6 6h12"></path></svg>
        {{ section.settings.cta_label | default: "Explore Tumblers" }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Valentine Tumblers",
  "tag": "section",
  "class": "valentine-tumblers-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Valentine Tumblers"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Premium drinkware — a daily reminder of love."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Explore Tumblers"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ],
  "blocks": [
    {
      "type": "tumbler_tier",
      "name": "Tumbler Tier",
      "settings": [
        {
          "type": "text",
          "id": "price_label",
          "label": "Price Label",
          "default": "₹1,099"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tier Tag",
          "default": "Everyday Love"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Product Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valentine Tumblers",
      "category": "Valentine's Special",
      "blocks": [
        { "type": "tumbler_tier", "settings": { "price_label": "₹1,099", "tag": "Everyday Love" } },
        { "type": "tumbler_tier", "settings": { "price_label": "₹2,099", "tag": "Signature Sip" } },
        { "type": "tumbler_tier", "settings": { "price_label": "₹3,099", "tag": "Premium Pour" } }
      ]
    }
  ]
}
{% endschema %}
