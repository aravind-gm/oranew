{% comment %}
  ═══════════════════════════════════════════════════════
  Valentine Media Loop — valentine-media-loop.liquid
  ORA Valentine's Special | Shopify OS 2.0
  
  Auto-scrolling horizontal carousel of images & videos
  Hover = pause | Click = redirect | Lazy loaded
  ═══════════════════════════════════════════════════════
{% endcomment %}

{%- style -%}
  .valentine-media-loop {
    padding: 2.5rem 0 3.5rem;
    background: #fff;
    overflow: hidden;
  }
  .valentine-media-loop__header {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.25rem 1.5rem;
  }
  @media (min-width: 640px) {
    .valentine-media-loop__header { padding: 0 2rem 1.5rem; }
  }
  .valentine-media-loop__label {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #E11D48;
    font-weight: 500;
  }
  .valentine-media-loop__track-wrap {
    position: relative;
    overflow: hidden;
    cursor: grab;
  }
  .valentine-media-loop__track-wrap:active { cursor: grabbing; }
  .valentine-media-loop__fade-left,
  .valentine-media-loop__fade-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 4rem;
    z-index: 10;
    pointer-events: none;
  }
  .valentine-media-loop__fade-left {
    left: 0;
    background: linear-gradient(to right, #fff, transparent);
  }
  .valentine-media-loop__fade-right {
    right: 0;
    background: linear-gradient(to left, #fff, transparent);
  }
  .valentine-media-loop__track {
    display: flex;
    gap: 1rem;
    width: max-content;
    animation: ora-media-scroll 50s linear infinite;
  }
  .valentine-media-loop__track:hover {
    animation-play-state: paused;
  }
  @keyframes ora-media-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .valentine-media-loop__card {
    flex-shrink: 0;
    width: 240px;
    height: 320px;
    border-radius: 1rem;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    text-decoration: none;
    display: block;
  }
  @media (min-width: 640px) {
    .valentine-media-loop__card {
      width: 320px;
      height: 420px;
    }
  }
  .valentine-media-loop__card:hover {
    transform: scale(1.03);
  }
  .valentine-media-loop__card img,
  .valentine-media-loop__card video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .valentine-media-loop__card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.3), transparent);
    z-index: 1;
  }
  .valentine-media-loop__card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2rem;
    font-style: italic;
    color: rgba(255,255,255,0.25);
    pointer-events: none;
    text-align: center;
    letter-spacing: 0.05em;
    z-index: 2;
  }
  @media (max-width: 640px) {
    .valentine-media-loop__card-overlay { font-size: 1.5rem; }
  }
{%- endstyle -%}

<section class="valentine-media-loop" data-section-id="{{ section.id }}">
  <div class="valentine-media-loop__header">
    <span class="valentine-media-loop__label">
      {{ section.settings.label | default: "Love in Every Detail" }}
    </span>
  </div>

  <div class="valentine-media-loop__track-wrap">
    <div class="valentine-media-loop__fade-left"></div>
    <div class="valentine-media-loop__fade-right"></div>

    <div class="valentine-media-loop__track" data-media-track>
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="valentine-media-loop__card" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="valentine-media-loop__card" {{ block.shopify_attributes }}>
        {%- endif -%}

          {%- if block.type == 'video' and block.settings.video_url != blank -%}
            <video autoplay muted loop playsinline loading="lazy">
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
          {%- elsif block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 640 }}"
              alt="{{ block.settings.alt | default: block.settings.overlay_text }}"
              loading="lazy"
              width="640"
              height="840"
            >
          {%- endif -%}

          <div class="valentine-media-loop__card-gradient"></div>

          {%- if block.settings.overlay_text != blank -%}
            <div class="valentine-media-loop__card-overlay">
              {{ block.settings.overlay_text }}
            </div>
          {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Duplicate for seamless loop -->
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="valentine-media-loop__card" aria-hidden="true">
        {%- else -%}
          <div class="valentine-media-loop__card" aria-hidden="true">
        {%- endif -%}

          {%- if block.type == 'video' and block.settings.video_url != blank -%}
            <video autoplay muted loop playsinline loading="lazy">
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
          {%- elsif block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 640 }}"
              alt=""
              loading="lazy"
              width="640"
              height="840"
            >
          {%- endif -%}

          <div class="valentine-media-loop__card-gradient"></div>

          {%- if block.settings.overlay_text != blank -%}
            <div class="valentine-media-loop__card-overlay">
              {{ block.settings.overlay_text }}
            </div>
          {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Valentine Media Loop",
  "tag": "section",
  "class": "valentine-media-loop-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Love in Every Detail"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt Text"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "Overlay Text",
          "info": "Shows behind image at low opacity. E.g. 'Unwrap Love'"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "video",
      "name": "Video Slide",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL (MP4)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback Image"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "Overlay Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valentine Media Loop",
      "category": "Valentine's Special",
      "blocks": [
        { "type": "image", "settings": { "overlay_text": "Unwrap Love" } },
        { "type": "image", "settings": { "overlay_text": "Made for Her" } },
        { "type": "image", "settings": { "overlay_text": "Everyday Romance" } }
      ]
    }
  ]
}
{% endschema %}
