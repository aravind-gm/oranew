{% comment %}
  ═══════════════════════════════════════════════════════
  Valentine Trust Strip — valentine-trust-strip.liquid
  ORA Valentine's Special | Shopify OS 2.0
  
  Trust signals + email capture — confidence + retention
  ═══════════════════════════════════════════════════════
{% endcomment %}

{%- style -%}
  .valentine-trust {
    padding: 4rem 1.25rem 5rem;
    background: #FAFAFA;
    border-top: 1px solid #F5F5F5;
  }
  @media (min-width: 640px) {
    .valentine-trust { padding: 5rem 2rem; }
  }
  .valentine-trust__inner {
    max-width: 80rem;
    margin: 0 auto;
  }
  .valentine-trust__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 4rem;
  }
  @media (min-width: 768px) {
    .valentine-trust__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem;
    }
  }
  .valentine-trust__item {
    text-align: center;
  }
  .valentine-trust__icon {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(145deg, #FFF5F7, #FCE7F3);
    margin: 0 auto 1rem;
    transition: transform 0.3s ease;
    color: #E11D48;
  }
  .valentine-trust__icon:hover {
    transform: scale(1.1);
  }
  .valentine-trust__item-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #171717;
    margin-bottom: 0.25rem;
  }
  .valentine-trust__item-desc {
    font-size: 0.75rem;
    color: #737373;
    line-height: 1.5;
  }
  /* Email capture */
  .valentine-trust__email {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
  }
  .valentine-trust__email-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .valentine-trust__email-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: #F43F5E;
  }
  .valentine-trust__email-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 1.875rem);
    color: #171717;
    font-weight: 300;
  }
  .valentine-trust__email-desc {
    color: #737373;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }
  .valentine-trust__email-form {
    display: flex;
    gap: 0.75rem;
    max-width: 28rem;
    margin: 0 auto;
  }
  .valentine-trust__email-input {
    border: 1px solid #E5E5E5;
    border-radius: 9999px;
    padding: 0.875rem 1.5rem;
    font-size: 0.875rem;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    width: 100%;
    background: #fff;
  }
  .valentine-trust__email-input:focus {
    border-color: #F43F5E;
    box-shadow: 0 0 0 3px rgba(244,63,94,0.08);
  }
  .valentine-trust__email-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: #BE123C;
    color: #fff;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .valentine-trust__email-btn:hover {
    background: #9F1239;
  }
  .valentine-trust__email-success {
    color: #E11D48;
    font-size: 0.875rem;
    margin-top: 1rem;
    display: none;
  }
  .valentine-trust__email-success.is-visible {
    display: block;
  }
{%- endstyle -%}

<section class="valentine-trust" data-section-id="{{ section.id }}">
  <div class="valentine-trust__inner">
    <!-- Trust Icons -->
    <div class="valentine-trust__grid">
      {%- for block in section.blocks -%}
        <div class="valentine-trust__item" {{ block.shopify_attributes }}>
          <div class="valentine-trust__icon">
            {%- case block.settings.icon -%}
              {%- when 'gift' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="8" width="18" height="14" rx="2"></rect><path d="M12 8V4a2 2 0 0 1 4 0v4M8 8V4a2 2 0 0 1 4 0"></path></svg>
              {%- when 'truck' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><path d="M16 8h4l3 4v5h-7"></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
              {%- when 'refresh' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6M1 20v-6h6"></path><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"></path></svg>
              {%- when 'heart' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              {%- else -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            {%- endcase -%}
          </div>
          <h4 class="valentine-trust__item-title">{{ block.settings.title }}</h4>
          <p class="valentine-trust__item-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>

    <!-- Email Capture -->
    <div class="valentine-trust__email">
      <div class="valentine-trust__email-header">
        <svg class="valentine-trust__email-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><path d="M22 6l-10 7L2 6"></path></svg>
        <h3 class="valentine-trust__email-title">{{ section.settings.email_title | default: "Join the ORA Family" }}</h3>
      </div>
      <p class="valentine-trust__email-desc">{{ section.settings.email_desc | default: "Be the first to know about new collections, exclusive offers & styling inspiration." }}</p>

      <form class="valentine-trust__email-form" data-email-form>
        <input
          type="email"
          class="valentine-trust__email-input"
          placeholder="Your email address"
          required
          aria-label="Email address"
        >
        <button type="submit" class="valentine-trust__email-btn">
          Join
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
        </button>
      </form>
      <p class="valentine-trust__email-success" data-email-success>Welcome to the ORA family! 💝</p>
    </div>
  </div>
</section>

<script>
  (function() {
    const form = document.querySelector('[data-section-id="{{ section.id }}"] [data-email-form]');
    if (!form) return;
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const input = form.querySelector('input[type="email"]');
      if (!input || !input.value) return;
      // Submit to Shopify customer API or Klaviyo
      fetch('/contact#contact_form', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: 'form_type=customer&utf8=✓&customer[email]=' + encodeURIComponent(input.value) + '&customer[tags]=newsletter,valentine'
      }).catch(() => {});
      input.value = '';
      const success = document.querySelector('[data-section-id="{{ section.id }}"] [data-email-success]');
      if (success) {
        success.classList.add('is-visible');
        setTimeout(() => success.classList.remove('is-visible'), 4000);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Valentine Trust Strip",
  "tag": "section",
  "class": "valentine-trust-section",
  "settings": [
    {
      "type": "text",
      "id": "email_title",
      "label": "Email Section Title",
      "default": "Join the ORA Family"
    },
    {
      "type": "text",
      "id": "email_desc",
      "label": "Email Description",
      "default": "Be the first to know about new collections, exclusive offers & styling inspiration."
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "gift", "label": "Gift" },
            { "value": "truck", "label": "Truck" },
            { "value": "refresh", "label": "Returns" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "gift"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Gift Wrapped"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Every order wrapped with love & a personal note"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valentine Trust Strip",
      "category": "Valentine's Special",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "gift", "title": "Gift Wrapped", "description": "Every order wrapped with love & a personal note" } },
        { "type": "trust_item", "settings": { "icon": "truck", "title": "Fast Delivery", "description": "Delivered before Valentine's Day, guaranteed" } },
        { "type": "trust_item", "settings": { "icon": "refresh", "title": "Easy Returns", "description": "7-day hassle-free returns on all orders" } },
        { "type": "trust_item", "settings": { "icon": "heart", "title": "50,000+ Happy Customers", "description": "Loved by women across India" } }
      ]
    }
  ]
}
{% endschema %}
