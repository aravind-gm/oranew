generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // PgBouncer-compatible settings:
  // - connection_limit=1 prevents pool exhaustion
  // - pool_mode=transaction for Render free-tier
  // - Render force-disconnects after 24hrs
}

// ============================================
// IMPORTANT: Supabase PgBouncer Configuration
// ============================================
// When using Supabase with Render (serverless/free tier):
// 
// DATABASE_URL should point to Supabase PgBouncer:
//   postgresql://postgres.[PROJECT]:[PWD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
//
// DIRECT_URL should point to direct Supabase connection:
//   postgresql://postgres.[PROJECT]:[PWD]@db.[PROJECT].supabase.co:5432/postgres
//
// This allows:
// - Prisma migrations use DIRECT_URL (fast, direct)
// - Regular queries use DATABASE_URL (pooled via PgBouncer)
// - Prevents "too many connections" errors on serverless
// - Compatible with Render's connection limits

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  supabaseId       String?         @unique @map("supabase_id")
  passwordHash     String?         @map("password_hash")
  fullName         String          @default("") @map("full_name")
  phone            String?
  gender           String?
  role             UserRole        @default(CUSTOMER)
  isVerified       Boolean         @default(false) @map("is_verified")
  profileCompleted Boolean         @default(false) @map("profile_completed")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  addresses        Address[]
  cartItems        CartItem[]
  notifications    Notification[]
  orders           Order[]
  returns          Return[]
  reviews          Review[]
  wishlists        Wishlist[]
  adminAuditLogs   AdminAuditLog[]

  @@map("users")
}

model Address {
  id             String      @id @default(uuid())
  userId         String      @map("user_id")
  fullName       String      @map("full_name")
  phone          String
  addressLine1   String      @map("address_line1")
  addressLine2   String?     @map("address_line2")
  city           String
  state          String
  pincode        String
  country        String      @default("India")
  isDefault      Boolean     @default(false) @map("is_default")
  addressType    AddressType @default(HOME) @map("address_type")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingOrders  Order[]     @relation("BillingAddress")
  shippingOrders Order[]     @relation("ShippingAddress")

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?    @map("image_url")
  parentId    String?    @map("parent_id")
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model Product {
  id                String          @id @default(uuid())
  name              String
  slug              String          @unique
  description       String?
  shortDescription  String?         @map("short_description") @db.VarChar(500)
  price             Decimal         @db.Decimal(10, 2)
  discountPercent   Decimal         @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  finalPrice        Decimal         @map("final_price") @db.Decimal(10, 2)
  sku               String          @unique
  categoryId        String          @map("category_id")
  material          String?
  careInstructions  String?         @map("care_instructions")
  weight            String?
  dimensions        String?
  stockQuantity     Int             @default(0) @map("stock_quantity")
  lowStockThreshold Int             @default(5) @map("low_stock_threshold")
  isActive          Boolean         @default(true) @map("is_active")
  isFeatured        Boolean         @default(false) @map("is_featured")
  
  // Gift Collections & Occasions
  collections       String[]        @default([]) // e.g., ["gifts-for-her", "valentine-special"]
  occasions         String[]        @default([]) // e.g., ["birthday", "anniversary", "valentine"]
  isFeaturedGift    Boolean         @default(false) @map("is_featured_gift") // Featured in Gifts For Her
  
  metaTitle         String?         @map("meta_title")
  metaDescription   String?         @map("meta_description")
  averageRating     Decimal         @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount       Int             @default(0) @map("review_count")

  // BOGO Campaign fields
  isBOGOEligible    Boolean         @default(false) @map("is_bogo_eligible")
  bogoPriceTier     Int?            @map("bogo_price_tier")
  bogoCategory      String?         @map("bogo_category")

  // Tumbler-specific fields
  isTumbler         Boolean         @default(false) @map("is_tumbler")
  capacity          String?         // e.g., "300ml", "500ml"
  isBestseller      Boolean         @default(false) @map("is_bestseller")

  // BOGO active toggle (separate from eligibility)
  bogoActive        Boolean         @default(false) @map("bogo_active")

  // Per-product GST rate (percentage). Defaults to 3% for jewellery.
  gstRate           Decimal         @default(3) @map("gst_rate") @db.Decimal(5, 2)

  // Offer fields
  isOnOffer         Boolean         @default(false) @map("is_on_offer")
  offerType         String?         @map("offer_type") // "PERCENT" | "BOGO" | "FIXED"
  offerValue        Decimal?        @map("offer_value") @db.Decimal(10, 2)
  offerExpiry       DateTime?       @map("offer_expiry")
  showCountdown     Boolean         @default(false) @map("show_countdown")

  // Soft delete
  deletedAt         DateTime?       @map("deleted_at")

  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  cartItems         CartItem[]
  inventoryLocks    InventoryLock[]
  orderItems        OrderItem[]
  images            ProductImage[]
  category          Category        @relation(fields: [categoryId], references: [id])
  reviews           Review[]
  wishlists         Wishlist[]
  combosAsPrimary   ComboProduct[]  @relation("ComboPrimary")
  combosAsFree      ComboProduct[]  @relation("ComboFree")

  @@index([slug])
  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isBOGOEligible, bogoPriceTier])
  @@index([collections])
  @@index([occasions])
  @@index([isOnOffer, offerType])
  @@index([isTumbler])
  @@index([isBestseller])
  @@map("products")
}

model ProductImage {
  id          String     @id @default(uuid())
  productId   String     @map("product_id")
  imageUrl    String     @map("image_url")
  altText     String?    @map("alt_text")
  sortOrder   Int        @default(0) @map("sort_order")
  isPrimary   Boolean    @default(false) @map("is_primary")
  imageRole   ImageRole? @map("image_role")
  cdnVerified Boolean    @default(false) @map("cdn_verified")
  originalUrl String?    @map("original_url")
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model Banner {
  id             String    @id @default(uuid())
  page           String
  title          String?
  imageUrl       String    @map("image_url")
  mobileImageUrl String?   @map("mobile_image_url")
  ctaText        String?   @map("cta_text")
  ctaLink        String?   @map("cta_link")
  position       String    @default("hero")
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([page])
  @@index([isActive])
  @@map("banners")
}

// ============================================
// ANNOUNCEMENTS
// ============================================

model Announcement {
  id              String    @id @default(uuid())
  message         String
  type            String    @default("bar") // bar, popup, toast
  backgroundColor String?   @map("background_color")
  textColor       String?   @map("text_color")
  link            String?
  linkText        String?   @map("link_text")
  isActive        Boolean   @default(true) @map("is_active")
  priority        Int       @default(1)
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([priority])
  @@map("announcements")
}

// ============================================
// STATIC PAGES
// ============================================

model StaticPage {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  content         String   @db.Text
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description") @db.Text
  isPublished     Boolean  @default(false) @map("is_published")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([isPublished])
  @@map("static_pages")
}

model CollectionImage {
  id             String   @id @default(uuid())
  collectionSlug String   @unique @map("collection_slug")
  heroUrl        String   @map("hero_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  altText        String?  @map("alt_text")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("collection_images")
}

model BrandAsset {
  id        String   @id @default(uuid())
  assetType String   @map("asset_type")
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brand_assets")
}

model ImageMigration {
  id           String    @id @default(uuid())
  originalUrl  String    @unique @map("original_url")
  newUrl       String    @map("new_url")
  entityType   String    @map("entity_type")
  entityId     String?   @map("entity_id")
  status       String    @default("pending")
  errorMessage String?   @map("error_message")
  migratedAt   DateTime? @map("migrated_at")
  verifiedAt   DateTime? @map("verified_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([entityType, entityId])
  @@map("image_migrations")
}

model Review {
  id                 String   @id @default(uuid())
  productId          String   @map("product_id")
  userId             String   @map("user_id")
  rating             Int
  title              String?
  reviewText         String?  @map("review_text")
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  isApproved         Boolean  @default(false) @map("is_approved")
  createdAt          DateTime @default(now()) @map("created_at")
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  addedAt   DateTime @default(now()) @map("added_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  addedAt   DateTime @default(now()) @map("added_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model Order {
  id                String          @id @default(uuid())
  orderNumber       String          @unique @map("order_number")
  userId            String          @map("user_id")
  status            OrderStatus     @default(PENDING)
  subtotal          Decimal         @db.Decimal(10, 2)
  discountAmount    Decimal         @default(0) @map("discount_amount") @db.Decimal(10, 2)
  couponCode        String?         @map("coupon_code")
  gstAmount         Decimal         @map("gst_amount") @db.Decimal(10, 2)
  shippingFee       Decimal         @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  totalAmount       Decimal         @map("total_amount") @db.Decimal(10, 2)
  shippingAddressId String          @map("shipping_address_id")
  billingAddressId  String          @map("billing_address_id")
  paymentMethod     String?         @map("payment_method")
  paymentStatus     PaymentStatus   @default(PENDING) @map("payment_status")
  trackingNumber    String?         @map("tracking_number")
  courierName       String?         @map("courier_name")
  shiprocketOrderId String?         @map("shiprocket_order_id")
  shipmentStatus    String?         @map("shipment_status")
  shippedAt         DateTime?       @map("shipped_at")
  deliveredAt       DateTime?       @map("delivered_at")
  cancelledAt       DateTime?       @map("cancelled_at")
  cancelReason      String?         @map("cancel_reason")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  inventoryLocks    InventoryLock[]
  items             OrderItem[]
  billingAddress    Address         @relation("BillingAddress", fields: [billingAddressId], references: [id])
  shippingAddress   Address         @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  user              User            @relation(fields: [userId], references: [id])
  payments          Payment[]
  returns           Return[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  productId    String  @map("product_id")
  productName  String  @map("product_name")
  productImage String? @map("product_image")
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  gstRate      Decimal @map("gst_rate") @db.Decimal(5, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(10, 2)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  paymentGateway  PaymentMethod @map("payment_gateway")
  transactionId   String?       @unique @map("transaction_id")
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?       @map("payment_method")
  gatewayResponse Json?         @map("gateway_response")
  createdAt       DateTime      @default(now()) @map("created_at")
  order           Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([transactionId])
  @@map("payments")
}

model Return {
  id           String       @id @default(uuid())
  orderId      String       @map("order_id")
  userId       String       @map("user_id")
  reason       String
  description  String?
  status       ReturnStatus @default(REQUESTED)
  refundAmount Decimal?     @map("refund_amount") @db.Decimal(10, 2)
  restocked    Boolean      @default(false)
  createdAt    DateTime     @default(now()) @map("created_at")
  resolvedAt   DateTime?    @map("resolved_at")
  order        Order        @relation(fields: [orderId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@map("returns")
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  description    String?
  discountType   DiscountType @map("discount_type")
  discountValue  Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount Decimal?     @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscount    Decimal?     @map("max_discount") @db.Decimal(10, 2)
  usageLimit     Int?         @map("usage_limit")
  usageCount     Int          @default(0) @map("usage_count")
  validFrom      DateTime     @map("valid_from")
  validUntil     DateTime     @map("valid_until")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("coupons")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String?          @map("user_id")
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model InventoryLock {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  orderId   String?  @map("order_id")
  quantity  Int
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([expiresAt])
  @@map("inventory_locks")
}


// ============================================
// COMBO / BUNDLE PRODUCTS
// ============================================

model ComboProduct {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  description      String?
  comboPrice       Decimal      @map("combo_price") @db.Decimal(10, 2)
  originalTotal    Decimal      @map("original_total") @db.Decimal(10, 2)
  savingsAmount    Decimal      @map("savings_amount") @db.Decimal(10, 2)
  discountPercent  Decimal      @map("discount_percent") @db.Decimal(5, 2)
  primaryProductId String       @map("primary_product_id")
  freeProductId    String       @map("free_product_id")
  primaryImage     String?      @map("primary_image")
  freeImage        String?      @map("free_image")
  hoverImage       String?      @map("hover_image")
  badge            String?      // "Bestseller", "Limited", "Most Gifted"
  tag              String?      // "Gift for Girlfriend", "Anniversary", etc.
  includes         String[]     @default([])
  averageRating    Decimal      @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount      Int          @default(0) @map("review_count")
  stockQuantity    Int          @default(0) @map("stock_quantity")
  soldCount        Int          @default(0) @map("sold_count")
  isActive         Boolean      @default(true) @map("is_active")
  isLimited        Boolean      @default(false) @map("is_limited")
  sortOrder        Int          @default(0) @map("sort_order")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  primaryProduct   Product      @relation("ComboPrimary", fields: [primaryProductId], references: [id])
  freeProduct      Product      @relation("ComboFree", fields: [freeProductId], references: [id])

  @@index([isActive])
  @@index([slug])
  @@index([sortOrder])
  @@map("combo_products")
}

model BOGOCampaign {
  id                String            @id @default(uuid())
  name              String            @default("BOGO Campaign")
  isActive          Boolean           @default(false) @map("is_active")
  discountType      BOGODiscountType  @default(FREE_CHEAPER) @map("discount_type")
  discountValue     Decimal           @default(0) @map("discount_value") @db.Decimal(10, 2)
  allowedTiers      Int[]             @default([999, 1499, 1999, 2599]) @map("allowed_tiers")
  allowedCategories String[]          @default([]) @map("allowed_categories")
  startDate         DateTime?         @map("start_date")
  endDate           DateTime?         @map("end_date")
  maxUsesPerUser    Int               @default(0) @map("max_uses_per_user")
  totalUsageCount   Int               @default(0) @map("total_usage_count")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("bogo_campaigns")
}

model OfferCampaign {
  id                  String    @id @default(uuid())
  name                String    @default("Offer Campaign")
  isActive            Boolean   @default(false) @map("is_active")
  discountType        String    @default("PERCENT") @map("discount_type") // "PERCENT" | "BOGO" | "FIXED"
  discountValue       Decimal   @default(0) @map("discount_value") @db.Decimal(10, 2)
  collections         String[]  @default([]) // included collection slugs
  startDate           DateTime? @map("start_date")
  endDate             DateTime? @map("end_date")
  showCountdown       Boolean   @default(true) @map("show_countdown")
  bannerText          String?   @map("banner_text")
  totalUsageCount     Int       @default(0) @map("total_usage_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("offer_campaigns")
}

// ============================================
// TAX CONFIGURATION
// ============================================

model TaxConfig {
  id            String   @id @default(uuid())
  categorySlug  String   @unique @map("category_slug") // e.g., "jewellery", "tumblers"
  gstRate       Decimal  @map("gst_rate") @db.Decimal(5, 2) // e.g., 3.00
  label         String   @default("GST") // Display label
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("tax_configs")
}

// ============================================
// SHIPPING CONFIGURATION
// ============================================

model ShippingConfig {
  id                String   @id @default(uuid())
  freeThreshold     Decimal  @map("free_threshold") @db.Decimal(10, 2) // ₹999
  standardFee       Decimal  @map("standard_fee") @db.Decimal(10, 2)   // ₹99
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("shipping_configs")
}

// ============================================
// ADMIN AUDIT LOG
// ============================================

model AdminAuditLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  action      String   // CREATE, UPDATE, DELETE, ARCHIVE, RESTORE, BULK_ACTION, CONFIG_CHANGE
  entityType  String   @map("entity_type") // PRODUCT, ORDER, CAMPAIGN, SHIPPING, TAX, CONTENT, USER
  entityId    String?  @map("entity_id")
  details     Json?    // Arbitrary details about the action
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

enum BOGODiscountType {
  FREE_CHEAPER
  PERCENT
  FIXED
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum ImageRole {
  THUMBNAIL
  LISTING
  HERO
  ZOOM
}

enum AddressType {
  HOME
  OFFICE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  CONFIRMED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  COD
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_SHIPPED
