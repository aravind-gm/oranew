{
  "name": "ora-jewellery",
  "version": "1.0.0",
  "private": true,
  "description": "Premium fashion jewellery e-commerce platform - own. radiate. adorn.",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend && npm run build:backend",
    "build:backend": "cd backend && npm run build",
    "build:render": "cd backend && npm run build:render",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "cd backend && npm start",
    "prisma:generate": "cd backend && npx prisma generate",
    "prisma:migrate": "cd backend && npx prisma migrate dev",
    "prisma:studio": "cd backend && npx prisma studio",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "lint": "cd frontend && npm run lint && cd ../backend && npm run lint",
    "cleanup-db": "cd backend && node scripts/cleanup-db.js",
    "cleanup-db:confirm": "cd backend && node scripts/cleanup-db.js --confirm",
    "seed": "cd backend && node seed.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=9.0.0"
  }
}
