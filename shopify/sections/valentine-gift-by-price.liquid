{% comment %}
  ═══════════════════════════════════════════════════════
  Valentine Gift by Price — valentine-gift-by-price.liquid
  ORA Valentine's Special | Shopify OS 2.0
  
  Heart-inspired gradient cards for price-tier navigation
  ═══════════════════════════════════════════════════════
{% endcomment %}

{%- style -%}
  .valentine-gift-price {
    padding: 4rem 1.25rem 5rem;
    background: #fff;
  }
  @media (min-width: 640px) {
    .valentine-gift-price { padding: 5rem 2rem; }
  }
  .valentine-gift-price__inner {
    max-width: 80rem;
    margin: 0 auto;
  }
  .valentine-gift-price__header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .valentine-gift-price__label {
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #E11D48;
    font-weight: 500;
  }
  .valentine-gift-price__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.875rem, 4vw, 3rem);
    color: #171717;
    margin-top: 0.75rem;
    font-weight: 300;
  }
  .valentine-gift-price__subtitle {
    color: #737373;
    margin-top: 1rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  .valentine-gift-price__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .valentine-gift-price__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .valentine-gift-price__card {
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    padding: 2.5rem 2rem;
    text-align: left;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    border: 1px solid transparent;
    text-decoration: none;
    display: block;
    color: inherit;
  }
  .valentine-gift-price__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 50px rgba(244, 63, 94, 0.1);
  }
  .valentine-gift-price__card::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    opacity: 0.06;
    transition: opacity 0.4s ease;
  }
  .valentine-gift-price__card:hover::before {
    opacity: 0.12;
  }
  .valentine-gift-price__card--tier-1 {
    background: linear-gradient(145deg, #FFF5F7, #FCE7F3);
  }
  .valentine-gift-price__card--tier-1::before { background: #F43F5E; }
  .valentine-gift-price__card--tier-2 {
    background: linear-gradient(145deg, #FDF2F8, #FCE4EC);
  }
  .valentine-gift-price__card--tier-2::before { background: #E11D48; }
  .valentine-gift-price__card--tier-3 {
    background: linear-gradient(145deg, #FFF1F2, #FFE4E6);
  }
  .valentine-gift-price__card--tier-3::before { background: #BE123C; }
  .valentine-gift-price__card-heart {
    width: 2rem;
    height: 2rem;
    color: #FB7185;
    margin-bottom: 1rem;
  }
  .valentine-gift-price__card-tag {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #E11D48;
    font-weight: 500;
    display: block;
    margin-bottom: 0.25rem;
  }
  .valentine-gift-price__card-price {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    color: #171717;
    margin: 0.25rem 0 0.75rem;
  }
  .valentine-gift-price__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #BE123C;
  }
  .valentine-gift-price__card-cta svg {
    transition: transform 0.3s ease;
  }
  .valentine-gift-price__card:hover .valentine-gift-price__card-cta svg {
    transform: translateX(4px);
  }
  @media (max-width: 640px) {
    .valentine-gift-price__card {
      padding: 1.75rem 1.5rem;
    }
  }
{%- endstyle -%}

<section class="valentine-gift-price" id="gift-by-price" data-section-id="{{ section.id }}">
  <div class="valentine-gift-price__inner">
    <div class="valentine-gift-price__header">
      <span class="valentine-gift-price__label">{{ section.settings.label | default: "Shop by Budget" }}</span>
      <h2 class="valentine-gift-price__title">{{ section.settings.title | default: "Gift by Price" }}</h2>
      <p class="valentine-gift-price__subtitle">{{ section.settings.subtitle | default: "Love isn't about the price tag — but a little guidance never hurts." }}</p>
    </div>

    <div class="valentine-gift-price__grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ block.settings.collection_link | default: '#' }}"
          class="valentine-gift-price__card valentine-gift-price__card--tier-{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          <svg class="valentine-gift-price__card-heart" viewBox="0 0 24 24" fill="rgba(244,63,94,0.1)" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
          <span class="valentine-gift-price__card-tag">{{ block.settings.tag }}</span>
          <div class="valentine-gift-price__card-price">{{ block.settings.price_label }}</div>
          <span class="valentine-gift-price__card-cta">
            View gifts →
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Valentine Gift by Price",
  "tag": "section",
  "class": "valentine-gift-price-section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Shop by Budget"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Gift by Price"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Love isn't about the price tag — but a little guidance never hurts."
    }
  ],
  "blocks": [
    {
      "type": "price_tier",
      "name": "Price Tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag Line",
          "default": "Thoughtful Tokens"
        },
        {
          "type": "text",
          "id": "price_label",
          "label": "Price Label",
          "default": "Under ₹1,099"
        },
        {
          "type": "url",
          "id": "collection_link",
          "label": "Collection Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valentine Gift by Price",
      "category": "Valentine's Special",
      "blocks": [
        { "type": "price_tier", "settings": { "tag": "Thoughtful Tokens", "price_label": "Under ₹1,099" } },
        { "type": "price_tier", "settings": { "tag": "Signature Gifts", "price_label": "Under ₹2,099" } },
        { "type": "price_tier", "settings": { "tag": "Grand Gestures", "price_label": "Under ₹3,099" } }
      ]
    }
  ]
}
{% endschema %}
