'use client';

import { supabase, isSupabaseConfigured } from '@/lib/supabase';
import { useAuthStore } from '@/store/authStore';
import api from '@/lib/api';
import Link from 'next/link';
import { useRouter, useSearchParams } from 'next/navigation';
import { Suspense, useState, useEffect } from 'react';
import { Mail, ArrowRight, Loader2, AlertCircle, Lock } from 'lucide-react';

function LoginForm() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const redirect = searchParams.get('redirect') || '/account';
  const { setToken, setUser, user, token, isHydrated } = useAuthStore();
  
  // Login Method State - Email only
  const method = 'email';
  
  // Input State - Email only
  const [email, setEmail] = useState('');
  
  // Admin Login State
  const [showAdminLogin, setShowAdminLogin] = useState(false);
  const [adminLoading, setAdminLoading] = useState(false);
  const [adminError, setAdminError] = useState('');
  
  // UI State
  const [step, setStep] = useState<'input' | 'sent'>('input');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');
  const [timer, setTimer] = useState(0);
  const [configError, setConfigError] = useState('');
  const [rateLimitError, setRateLimitError] = useState('');
  const [rateLimitTimer, setRateLimitTimer] = useState(0);

  // Check Supabase configuration on mount
  useEffect(() => {
    if (!isSupabaseConfigured) {
      setConfigError('Authentication service is not configured. Please try again later.');
      console.error('[LoginForm] Supabase not configured');
    }
  }, []);

  // 🔒 SINGLE REDIRECT AUTHORITY - Login page guard
  // Only redirect after hydration is complete
  useEffect(() => {
    if (!isHydrated) return;

    if (user && token) {
      console.log('[LoginForm] ✅ User already authenticated, redirecting to /account');
      router.replace('/account');
    }
  }, [isHydrated, user, token, router]);

  // TODO: REMOVE BEFORE PRODUCTION - Admin keyboard shortcut (Ctrl+Shift+A)
  useEffect(() => {
    // Only in development/testing, never in production
    if (process.env.NODE_ENV === 'production') return;

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.ctrlKey && e.shiftKey && e.key === 'A') {
        e.preventDefault();
        setShowAdminLogin(true);
        console.log('[Admin Access] Shortcut triggered (Ctrl+Shift+A)');
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, []);

  // Timer Effect
  useEffect(() => {
    let interval: NodeJS.Timeout;
    if (timer > 0) {
      interval = setInterval(() => setTimer((prev) => prev - 1), 1000);
    }
    return () => clearInterval(interval);
  }, [timer]);

  // Rate Limit Timer Effect - Auto-clear when expired
  useEffect(() => {
    let interval: NodeJS.Timeout;
    if (rateLimitTimer > 0) {
      interval = setInterval(() => setRateLimitTimer((prev) => prev - 1), 1000);
    } else if (rateLimitTimer === 0 && rateLimitError) {
      // Clear rate limit error when timer expires
      setRateLimitError('');
      setLoading(false);
    }
    return () => clearInterval(interval);
  }, [rateLimitTimer, rateLimitError]);

  // Handle email input change - reset all rate limit state
  const handleEmailChange = (newEmail: string) => {
    setEmail(newEmail);
    // Reset rate limit state when email changes
    if (rateLimitTimer > 0 || rateLimitError) {
      setRateLimitTimer(0);
      setRateLimitError('');
      setError('');
      setLoading(false);
    }
  };

  const handleSendMagicLink = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoading(true);
    setError('');
    setRateLimitError('');

    // Check if user is rate limited
    if (rateLimitTimer > 0) {
      setLoading(false);
      return;
    }

    // Basic Validation - Email only
    if (!email) {
      setError('Please enter your email address');
      setLoading(false);
      return;
    }

    try {
      // Validate Supabase configuration
      if (!supabase) {
        throw new Error('Authentication service is not configured. Please contact support.');
      }

      // Add detailed logging for debugging
      console.log('[Magic Link] Sending link to:', email);
      console.log('[Magic Link] Supabase URL:', process.env.NEXT_PUBLIC_SUPABASE_URL?.substring(0, 20) + '...');

      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: {
          shouldCreateUser: true,
          emailRedirectTo: `${window.location.origin}/auth/callback`,
        },
      });
      
      if (error) {
        // Check if it's a rate limit error
        if (error.message?.toLowerCase().includes('rate limit') || error.message?.toLowerCase().includes('over_email_send_rate_limit')) {
          console.warn('[Magic Link] Rate limit hit');
          setRateLimitTimer(60); // Wait 60 seconds
          setRateLimitError('You\'ve requested a login link recently. Please wait a moment before trying again.');
          setLoading(false);
          return;
        }
        throw error;
      }

      setStep('sent');
      setTimer(30); // 30 seconds before resend is available
    } catch (err: any) {
      // Enhanced error message
      let errorMessage = 'Failed to send login link';
      
      if (err.message) {
        if (err.message.includes('rate limit') || err.message.includes('Rate limit') || err.message.includes('over_email_send_rate_limit')) {
          errorMessage = 'You\'ve requested a login link recently. Please wait a moment before trying again.';
          setRateLimitTimer(60);
          setRateLimitError(errorMessage);
        } else if (err.message.includes('Failed to fetch')) {
          errorMessage = 'Network error. Please check your connection and try again.';
        } else if (err.message.includes('invalid')) {
          errorMessage = 'Invalid email address. Please check and try again.';
        } else {
          errorMessage = err.message;
        }
      }
      
      if (!errorMessage.includes('rate limit')) {
        setError(errorMessage);
      }
      
      console.error('[Magic Link Send Error]', err);
    } finally {
      setLoading(false);
    }
  };

  const handleResendLink = async () => {
    // Check rate limit first
    if (rateLimitTimer > 0) {
      setRateLimitError(`Please wait ${rateLimitTimer} seconds`);
      return;
    }
    
    setLoading(true);
    setError('');
    setRateLimitError('');
    await handleSendMagicLink(new Event('submit') as any);
  };

  const resetFlow = () => {
    setStep('input');
    setEmail('');
    setError('');
    setRateLimitError('');
    setRateLimitTimer(0);
    setTimer(0);
    setLoading(false);
  };

  // TODO: REMOVE BEFORE PRODUCTION - Admin test account login
  const handleAdminLogin = async (e: React.FormEvent) => {
    // Safety guard: Only allow in non-production environments
    if (process.env.NODE_ENV === 'production') {
      console.error('[Admin Login] Attempted in production - blocked');
      setAdminError('Admin login not available in production');
      return;
    }

    e.preventDefault();
    setAdminLoading(true);
    setAdminError('');

    try {
      console.log('[Admin Login] Attempting test account login');
      
      // Login with Supabase directly (admin@orashop.in)
      const { data, error } = await supabase.auth.signInWithPassword({
        email: 'admin@orashop.in',
        password: 'admin123',
      });

      if (error) {
        console.error('[Admin Login] Supabase error:', error.message);
        setAdminError(error.message);
        setAdminLoading(false);
        return;
      }

      if (data.session?.user) {
        const user = data.session.user;
        console.log('[Admin Login] ✅ Test admin logged in:', user.email);

        // Store in auth store
        setToken(data.session.access_token);
        setUser({
          id: user.id,
          email: user.email || '',
          fullName: user.user_metadata?.full_name || 'Admin',
          phone: user.user_metadata?.phone,
          role: user.user_metadata?.role || 'admin',
        });

        // Clear admin form
        setShowAdminLogin(false);
        
        // ✅ DO NOT REDIRECT HERE - Let AuthStateSync + LoginForm guard handle it
        console.log('[Admin Login] ✅ Login stored, guards will handle redirect');
      } else {
        setAdminError('Login failed - no session returned');
      }
    } catch (err: any) {
      console.error('[Admin Login Error]', err);
      setAdminError(err?.message || 'Admin login failed');
    } finally {
      setAdminLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-background flex flex-col lg:flex-row">
      {/* Left Side - Form */}
      <div className="flex-1 flex flex-col items-center justify-center px-4 py-8 sm:p-8 bg-white lg:bg-transparent">
        <div className="w-full max-w-md">
          {/* Logo */}
          <Link href="/" className="inline-block mb-8 lg:mb-12">
            <span className="text-3xl font-serif font-bold text-accent tracking-wide">ORA</span>
          </Link>

          <div className="mb-8">
            <h1 className="text-3xl sm:text-4xl font-serif font-medium text-text-primary mb-3">
              {step === 'input' ? 'Welcome Back' : 'Check Your Email'}
            </h1>
            <p className="text-text-muted">
               {step === 'input' 
                 ? 'We\'ll send you a secure login link to your email' 
                 : 'Click the link in your email to continue'
               }
            </p>
          </div>

          {configError && (
            <div className="mb-6 p-4 bg-red-50 border border-red-100 rounded-xl flex items-start gap-3 animate-in fade-in slide-in-from-top-2">
              <AlertCircle className="w-5 h-5 text-red-500 shrink-0 mt-0.5" />
              <p className="text-red-600 text-sm">{configError}</p>
            </div>
          )}

          {rateLimitError && (
            <div className="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-xl flex items-start gap-3 animate-in fade-in slide-in-from-top-2">
              <AlertCircle className="w-5 h-5 text-amber-600 shrink-0 mt-0.5" />
              <div className="text-amber-800 text-sm">
                <p className="font-medium">Please wait</p>
                <p className="mt-1">{rateLimitError}</p>
              </div>
            </div>
          )}

          {error && (
            <div className="mb-6 p-4 bg-red-50 border border-red-100 rounded-xl flex items-start gap-3 animate-in fade-in slide-in-from-top-2">
              <AlertCircle className="w-5 h-5 text-red-500 shrink-0 mt-0.5" />
              <p className="text-red-600 text-sm">{error}</p>
            </div>
          )}

          {step === 'input' ? (
              <>
                <form onSubmit={handleSendMagicLink} className="space-y-6">
                    <div className="space-y-2">
                        <label className="text-sm font-medium text-text-primary ml-1">Email Address</label>
                        <div className="relative group">
                            <input
                                type="email"
                                value={email}
                                onChange={(e) => handleEmailChange(e.target.value)}
                                disabled={!!configError}
                                className="w-full px-4 py-4 bg-transparent border border-gray-200 rounded-xl outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all pl-12 disabled:opacity-50 disabled:cursor-not-allowed"
                                placeholder="name@example.com"
                                required
                            />
                            <Mail className="w-5 h-5 text-gray-400 absolute left-4 top-1/2 -translate-y-1/2 transition-colors group-focus-within:text-accent" />
                        </div>
                        {rateLimitTimer > 0 && (
                          <p className="text-xs text-orange-600 mt-1">
                            💡 Or change your email to try again immediately
                          </p>
                        )}
                    </div>

                    <button
                        type="submit"
                        disabled={loading || !!configError || rateLimitTimer > 0}
                        className="w-full bg-primary text-white py-4 rounded-xl font-medium text-base hover:bg-primary/90 transition-all flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed group shadow-lg shadow-primary/20"
                    >
                       {loading ? (
                           <>
                             <Loader2 className="w-5 h-5 animate-spin" />
                             Sending...
                           </>
                       ) : rateLimitTimer > 0 ? (
                           <>
                             ⏱️ Wait {rateLimitTimer}s
                           </>
                       ) : (
                           <>
                             Send Login Link <ArrowRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
                           </>
                       )}
                    </button>
                </form>
              </>
          ) : (
              // MAGIC LINK SENT STEP
              <div className="w-full space-y-6">
                  <div className="text-center space-y-3 p-6 bg-green-50 border border-green-100 rounded-xl">
                       <div className="flex justify-center mb-2">
                           <div className="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                               <Mail className="w-6 h-6 text-green-600" />
                           </div>
                       </div>
                       <h3 className="font-semibold text-text-primary">Check your email</h3>
                       <p className="text-sm text-text-muted">
                           We've sent a secure login link to <span className="font-medium text-text-primary">{email}</span>
                       </p>
                       <p className="text-xs text-text-muted mt-2">
                           The link will expire in 24 hours
                       </p>
                  </div>

                  <div className="space-y-3 text-center">
                       <p className="text-sm text-text-muted">Didn't receive the email?</p>
                       
                       {rateLimitTimer > 0 ? (
                           <div className="p-3 bg-amber-50 border border-amber-200 rounded-lg">
                               <p className="text-sm text-amber-700">
                                   Please wait <span className="font-semibold">{rateLimitTimer}s</span> before requesting again
                               </p>
                           </div>
                       ) : timer > 0 ? (
                           <div className="p-3 bg-blue-50 border border-blue-100 rounded-lg">
                               <p className="text-sm text-blue-600">
                                   You can resend in <span className="font-semibold">{timer} seconds</span>
                               </p>
                           </div>
                       ) : (
                           <button 
                             onClick={handleResendLink}
                             disabled={loading}
                             className="w-full px-4 py-2 text-accent font-medium border border-accent rounded-lg hover:bg-accent/5 transition-all disabled:opacity-50 disabled:cursor-not-allowed"
                           >
                               {loading ? 'Sending...' : 'Resend Login Link'}
                           </button>
                       )}
                       
                       <button 
                         onClick={resetFlow} 
                         className="w-full text-sm text-text-muted hover:text-primary transition-colors py-2"
                       >
                           Use different email
                       </button>
                  </div>

                  <div className="p-4 bg-blue-50 border border-blue-100 rounded-lg space-y-3">
                      <p className="text-xs font-semibold text-blue-900">💡 Didn't get the email?</p>
                      <ul className="text-xs text-blue-800 space-y-1">
                          <li>✓ Check your spam or promotions folder</li>
                          <li>✓ Emails usually arrive within 1-2 minutes</li>
                          <li>✓ Try requesting again if needed</li>
                      </ul>
                  </div>
              </div>
          )}

          {/* Admin Quick Login Section - Hidden trigger via Ctrl+Shift+A */}
          {process.env.NODE_ENV !== 'production' && (
            <div className="mt-8 pt-6 border-t border-gray-100">
              <button
                type="button"
                onClick={() => setShowAdminLogin(!showAdminLogin)}
                className="w-full flex items-center justify-center gap-2 text-xs text-text-muted hover:text-primary transition-colors py-2"
              >
                <Lock className="w-3 h-3" />
                {showAdminLogin ? 'Hide' : 'Admin Access'}
              </button>

              {showAdminLogin && (
                <div className="mt-4 pt-4 border-t border-gray-100 space-y-3 bg-amber-50 p-3 rounded-lg">
                  <p className="text-xs text-amber-700 text-center font-medium">⚠️ Test Admin Account</p>
                  
                  {adminError && (
                    <div className="p-2 bg-red-50 border border-red-100 rounded flex items-start gap-2">
                      <AlertCircle className="w-3 h-3 text-red-500 shrink-0 mt-0.5" />
                      <p className="text-red-600 text-xs">{adminError}</p>
                    </div>
                  )}

                  <form onSubmit={handleAdminLogin} className="space-y-2">
                    <p className="text-xs text-gray-600">Email: admin@orashop.in</p>
                    
                    <button
                      type="submit"
                      disabled={adminLoading}
                      className="w-full bg-accent text-white py-2 rounded-lg font-medium text-sm hover:bg-accent/90 transition-all flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed"
                    >
                      {adminLoading ? (
                        <>
                          <Loader2 className="w-3 h-3 animate-spin" />
                          <span>Logging in...</span>
                        </>
                      ) : (
                        <>
                          <Lock className="w-3 h-3" />
                          <span>Login as Admin</span>
                        </>
                      )}
                    </button>
                  </form>

                  <button
                    type="button"
                    onClick={() => {
                      setShowAdminLogin(false);
                      setAdminError('');
                    }}
                    className="w-full text-xs text-text-muted hover:text-primary transition-colors"
                  >
                    Close
                  </button>
                </div>
              )}
            </div>
          )}

           <div className="mt-12 text-center border-t border-gray-100 pt-8">
            <p className="text-text-muted text-sm">
              New here?{' '}
              <span className="text-text-primary font-medium">
                  {step === 'input' ? 'Just sign in, we\'ll create an account.' : 'Your account will be created automatically.'}
              </span>
            </p>
          </div>        </div>
      </div>

      {/* Right Side - Image */}
      <div className="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-primary/5">
        <div className="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1531995811006-35cb42e1a022?q=80&w=2070&auto=format&fit=crop')] bg-cover bg-center opacity-80" />
        <div className="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
        
        <div className="absolute bottom-0 left-0 right-0 p-16 text-white z-10">
          <h2 className="text-4xl font-serif font-medium mb-4">"Adornments that tell y<span className="italic">our</span> story."</h2>
          <div className="flex gap-2 mb-8">
              <div className="h-1 w-12 bg-white rounded-full" />
              <div className="h-1 w-2 bg-white/30 rounded-full" />
              <div className="h-1 w-2 bg-white/30 rounded-full" />
          </div>
          <div className="flex gap-8">
              <div>
                  <p className="text-3xl font-serif font-bold">10k+</p>
                  <p className="text-white/80 text-sm">Community</p>
              </div>
              <div>
                  <p className="text-3xl font-serif font-bold">4.9</p>
                  <p className="text-white/80 text-sm">Rating</p>
              </div>
          </div>
        </div>
      </div>
    </div>
  );
}

export default function LoginPage() {
  return (
    <Suspense fallback={<div className="min-h-screen flex items-center justify-center bg-background">Loading...</div>}>
      <LoginForm />
    </Suspense>
  );
}
