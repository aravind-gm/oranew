{% comment %}
  ═══════════════════════════════════════════════════════
  Valentine Emotional Statement — valentine-statement.liquid
  ORA Valentine's Special | Shopify OS 2.0
  
  Emotional pause + trust-building centered text
  ═══════════════════════════════════════════════════════
{% endcomment %}

{%- style -%}
  .valentine-statement {
    position: relative;
    padding: 5rem 1.25rem;
    background: #fff;
    overflow: hidden;
    text-align: center;
  }
  @media (min-width: 640px) {
    .valentine-statement { padding: 7rem 2rem; }
  }
  .valentine-statement__deco-heart {
    position: absolute;
    opacity: 0.03;
    pointer-events: none;
    color: #F43F5E;
  }
  .valentine-statement__deco-heart--left {
    top: 2.5rem;
    left: 10%;
    width: 8rem;
    height: 8rem;
  }
  .valentine-statement__deco-heart--right {
    bottom: 2.5rem;
    right: 8%;
    width: 6rem;
    height: 6rem;
    transform: rotate(12deg);
  }
  .valentine-statement__inner {
    max-width: 48rem;
    margin: 0 auto;
  }
  .valentine-statement__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .valentine-statement__divider-line {
    width: 3rem;
    height: 1px;
    background: #FECDD3;
  }
  .valentine-statement__divider-heart {
    width: 1rem;
    height: 1rem;
    color: #FDA4AF;
  }
  .valentine-statement__headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 3rem);
    font-weight: 300;
    font-style: italic;
    color: #171717;
    line-height: 1.3;
    margin-bottom: 1.25rem;
  }
  .valentine-statement__supporting {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #737373;
    line-height: 1.6;
    max-width: 36rem;
    margin: 0 auto;
  }
  .valentine-statement__divider--bottom {
    margin-top: 2rem;
    margin-bottom: 0;
  }
  /* Scroll reveal */
  .valentine-statement__inner {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }
  .valentine-statement__inner.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
{%- endstyle -%}

<section class="valentine-statement" data-section-id="{{ section.id }}">
  <!-- Decorative hearts -->
  <svg class="valentine-statement__deco-heart valentine-statement__deco-heart--left" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
  <svg class="valentine-statement__deco-heart valentine-statement__deco-heart--right" viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>

  <div class="valentine-statement__inner" data-scroll-reveal>
    <div class="valentine-statement__divider">
      <span class="valentine-statement__divider-line"></span>
      <svg class="valentine-statement__divider-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
      <span class="valentine-statement__divider-line"></span>
    </div>

    <h2 class="valentine-statement__headline">
      &ldquo;{{ section.settings.headline | default: "Because the right gift becomes a memory." }}&rdquo;
    </h2>

    <p class="valentine-statement__supporting">
      {{ section.settings.supporting | default: "Every ORA piece comes gift-wrapped with love." }}
    </p>

    <div class="valentine-statement__divider valentine-statement__divider--bottom">
      <span class="valentine-statement__divider-line"></span>
      <svg class="valentine-statement__divider-heart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
      <span class="valentine-statement__divider-line"></span>
    </div>
  </div>
</section>

<script>
  // Intersection Observer for scroll reveal
  (function() {
    const el = document.querySelector('[data-section-id="{{ section.id }}"] [data-scroll-reveal]');
    if (!el) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    observer.observe(el);
  })();
</script>

{% schema %}
{
  "name": "Valentine Statement",
  "tag": "section",
  "class": "valentine-statement-section",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Because the right gift becomes a memory."
    },
    {
      "type": "text",
      "id": "supporting",
      "label": "Supporting Text",
      "default": "Every ORA piece comes gift-wrapped with love."
    }
  ],
  "presets": [
    {
      "name": "Valentine Statement",
      "category": "Valentine's Special"
    }
  ]
}
{% endschema %}
