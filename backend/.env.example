# ═══════════════════════════════════════════════════════════════
# ORA Jewellery — Backend Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this to .env and fill in your values

# ────────────────────────────────────────────
# DATABASE
# ────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/oranew"

# ────────────────────────────────────────────
# EMAIL (Gmail recommended — use App Password)
# ────────────────────────────────────────────
# Step 1: Enable 2FA on your Google account
# Step 2: Go to https://myaccount.google.com/apppasswords
# Step 3: Generate an app password for "Mail"
# Step 4: Use that 16-character password below (NOT your Gmail password)
#
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="ORA Jewellery <your-email@gmail.com>"

# ────────────────────────────────────────────
# WHATSAPP NOTIFICATIONS (FREE options)
# ────────────────────────────────────────────
# Choose one provider:
#   'log'       — Console only (development)
#   'callmebot' — FREE, unlimited (recommended for small business)
#   'meta-cloud' — 1000 free conversations/month
#
WHATSAPP_PROVIDER=callmebot

# Partner phone numbers to receive order alerts (comma-separated)
PARTNER_PHONES=+919842253984,+919342865987,+919095007887

# --- CallMeBot Setup (if WHATSAPP_PROVIDER=callmebot) ---
# Each partner must send "I allow callmebot to send me messages"
# to +34 644 51 98 02 on WhatsApp. They'll receive an API key.
CALLMEBOT_PHONES=+919842253984:APIKEY1,+919342865987:APIKEY2,+919095007887:APIKEY3

# --- Meta Cloud API (if WHATSAPP_PROVIDER=meta-cloud) ---
# Create app at https://developers.facebook.com/apps
# META_WHATSAPP_TOKEN=your_access_token
# META_WHATSAPP_PHONE_ID=your_phone_number_id

# ────────────────────────────────────────────
# FRONTEND URL (for email CTAs)
# ────────────────────────────────────────────
FRONTEND_URL=https://orashop.in

# ────────────────────────────────────────────
# AUTH
# ────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# ────────────────────────────────────────────
# REDIS (for OTP storage, rate limiting)
# ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────────
# PAYMENT (Razorpay)
# ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxx
