{% comment %}
  ═══════════════════════════════════════════════════════
  Valentine Combos — valentine-combos.liquid
  ORA Valentine's Special | Shopify OS 2.0
  
  Core AOV driver — lifestyle combo cards with badges
  ═══════════════════════════════════════════════════════
{% endcomment %}

{%- style -%}
  .valentine-combos {
    padding: 4rem 1.25rem 5rem;
    background: #FAFAFA;
  }
  @media (min-width: 640px) {
    .valentine-combos { padding: 5rem 2rem; }
  }
  .valentine-combos__inner {
    max-width: 80rem;
    margin: 0 auto;
  }
  .valentine-combos__header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .valentine-combos__label {
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #E11D48;
    font-weight: 500;
  }
  .valentine-combos__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.875rem, 4vw, 3rem);
    color: #171717;
    margin-top: 0.75rem;
    font-weight: 300;
  }
  .valentine-combos__subtitle {
    color: #737373;
    margin-top: 1rem;
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
  }
  .valentine-combos__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .valentine-combos__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .valentine-combos__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .valentine-combos__card {
    border-radius: 1.25rem;
    overflow: hidden;
    background: #fff;
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .valentine-combos__card:hover {
    box-shadow: 0 16px 48px rgba(0,0,0,0.1);
    transform: translateY(-4px);
  }
  .valentine-combos__card-image {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: #F5F5F5;
  }
  .valentine-combos__card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  .valentine-combos__card:hover .valentine-combos__card-image img {
    transform: scale(1.05);
  }
  .valentine-combos__card-badges {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .valentine-combos__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .valentine-combos__badge--bestseller {
    background: rgba(190,18,60,0.9);
    color: #fff;
  }
  .valentine-combos__badge--limited {
    background: rgba(212,175,55,0.9);
    color: #fff;
  }
  .valentine-combos__card-savings {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 600;
    background: #059669;
    color: #fff;
  }
  .valentine-combos__card-body {
    padding: 1.25rem;
  }
  .valentine-combos__card-type {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #E11D48;
  }
  .valentine-combos__card-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.125rem;
    color: #171717;
    margin: 0.25rem 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .valentine-combos__card-pricing {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .valentine-combos__card-price {
    font-size: 1.25rem;
    font-weight: 600;
    color: #171717;
  }
  .valentine-combos__card-compare {
    font-size: 0.875rem;
    color: #A3A3A3;
    text-decoration: line-through;
  }
  .valentine-combos__card-atc {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    background: #1A1A1A;
    color: #fff;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  .valentine-combos__card-atc:hover {
    background: #333;
  }
  .valentine-combos__cta-wrap {
    text-align: center;
    margin-top: 3rem;
  }
  .valentine-combos__cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #BE123C;
    font-weight: 500;
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .valentine-combos__cta-link:hover { color: #9F1239; }
  .valentine-combos__cta-link svg {
    transition: transform 0.3s ease;
  }
  .valentine-combos__cta-link:hover svg {
    transform: translateX(4px);
  }
{%- endstyle -%}

<section class="valentine-combos" id="combos" data-section-id="{{ section.id }}">
  <div class="valentine-combos__inner">
    <div class="valentine-combos__header">
      <span class="valentine-combos__label">Curated with Love</span>
      <h2 class="valentine-combos__title">{{ section.settings.title | default: "Valentine Combos" }}</h2>
      <p class="valentine-combos__subtitle">{{ section.settings.subtitle | default: "Thoughtfully paired sets that say it all." }}</p>
    </div>

    {%- assign combo_collection = collections[section.settings.collection] -%}

    {%- if combo_collection != blank and combo_collection.products.size > 0 -%}
      <div class="valentine-combos__grid">
        {%- for product in combo_collection.products limit: 6 -%}
          {%- assign savings = product.compare_at_price | minus: product.price -%}

          <a href="{{ product.url }}" class="valentine-combos__card">
            <div class="valentine-combos__card-image">
              {%- if product.featured_image != blank -%}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                  width="800"
                  height="1000"
                >
              {%- endif -%}

              <div class="valentine-combos__card-badges">
                {%- for tag in product.tags -%}
                  {%- if tag == 'bestseller' -%}
                    <span class="valentine-combos__badge valentine-combos__badge--bestseller">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                      Best Seller
                    </span>
                  {%- endif -%}
                  {%- if tag == 'limited' -%}
                    <span class="valentine-combos__badge valentine-combos__badge--limited">Limited</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if savings > 0 -%}
                <span class="valentine-combos__card-savings">Save {{ savings | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </div>

            <div class="valentine-combos__card-body">
              <span class="valentine-combos__card-type">Valentine Combo</span>
              <h3 class="valentine-combos__card-name">{{ product.title }}</h3>
              <div class="valentine-combos__card-pricing">
                <span class="valentine-combos__card-price">{{ product.price | money_without_trailing_zeros }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="valentine-combos__card-compare">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                {%- endif -%}
              </div>
              <button type="button" class="valentine-combos__card-atc" data-product-id="{{ product.variants.first.id }}">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4zM3 6h18M16 10a4 4 0 01-8 0"></path></svg>
                Add to Bag
              </button>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div style="text-align:center;padding:4rem 0;">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#FDA4AF" stroke-width="1.5" style="margin:0 auto 1rem;display:block;"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
        <p style="color:#737373;font-family:'Cormorant Garamond',serif;font-size:1.125rem;font-style:italic;">Combos coming soon...</p>
      </div>
    {%- endif -%}

    <div class="valentine-combos__cta-wrap">
      <a href="{{ section.settings.cta_link | default: '/collections/combos' }}" class="valentine-combos__cta-link">
        {{ section.settings.cta_label | default: "Explore Combos" }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Valentine Combos",
  "tag": "section",
  "class": "valentine-combos-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Valentine Combos"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Thoughtfully paired sets that say it all."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Combos Collection"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Label",
      "default": "Explore Combos"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    }
  ],
  "presets": [
    {
      "name": "Valentine Combos",
      "category": "Valentine's Special"
    }
  ]
}
{% endschema %}
