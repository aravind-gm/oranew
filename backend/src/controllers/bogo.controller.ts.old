// Mutable state for mock data
let campaignState = { ...MOCK_CAMPAIGN };
let productsState = [...MOCK_BOGO_PRODUCTS];

// ============================================================
// ADMIN: Get Campaign Settings
// ============================================================
export const getBOGOCampaign = async (
  req: AuthRequest,
  res: Response,
  next: NextFunction,
) => {
  try {
    res.json({
      success: true,
      data: campaignState,
    });
  } catch (error) {
    next(error);
  }
};

// ============================================================
// ADMIN: Update Campaign Settings
// ============================================================
export const updateBOGOCampaign = async (
  req: AuthRequest,
  res: Response,
  next: NextFunction,
) => {
  try {
    const {
      name,
      isActive,
      discountType,
      discountValue,
      allowedTiers,
      allowedCategories,
      startDate,
      endDate,
      maxUsesPerUser,
    } = req.body;

    // Update mutable mock state
    if (name !== undefined) campaignState.name = name;
    if (isActive !== undefined) campaignState.isActive = isActive;
    if (discountType !== undefined) campaignState.discountType = discountType;
    if (discountValue !== undefined) campaignState.discountValue = discountValue;
    if (allowedTiers !== undefined) campaignState.allowedTiers = allowedTiers;
    if (allowedCategories !== undefined) campaignState.allowedCategories = allowedCategories;
    if (startDate !== undefined) campaignState.startDate = startDate;
    if (endDate !== undefined) campaignState.endDate = endDate;
    if (maxUsesPerUser !== undefined) campaignState.maxUsesPerUser = maxUsesPerUser;
    campaignState.updatedAt = new Date().toISOString();

    res.json({
      success: true,
      data: campaignState,
      message: 'BOGO campaign updated successfully',
    });
  } catch (error) {
    next(error);
  }
};

// ============================================================
// ADMIN: Get All Products with BOGO Status
// ============================================================
export const getBOGOProducts = async (
  req: AuthRequest,
  res: Response,
  next: NextFunction,
) => {
  try {
    const {
      search,
      tier,
      category,
      bogoOnly,
      page = '1',
      limit = '50',
    } = req.query as Record<string, string>;

    // Build Prisma where clause
    const where: any = {};

    // Search filter
    if (search) {
      where.OR = [
        { name: { contains: search, mode: 'insensitive' } },
        { slug: { contains: search, mode: 'insensitive' } },
      ];
    }

    // BOGO-only filter
    if (bogoOnly === 'true') {
      where.isBOGOEligible = true;
    }

    // Tier filter
    if (tier) {
      where.bogoPriceTier = parseInt(tier);
    }

    // Category filter
    if (category && category !== 'all') {
      where.bogoCategory = category;
    }

    const pageNum = parseInt(page);
    const limitNum = parseInt(limit);

    // Fetch products from database
    const [products, total] = await Promise.all([
      prisma.product.findMany({
        where,
        select: {
          id: true,
          name: true,
          slug: true,
          price: true,
          finalPrice: true,
          image: true,
          hoverImage: true,
          isBOGOEligible: true,
          bogoCategory: true,
          bogoPriceTier: true,
          stockQuantity: true,
          averageRating: true,
          reviewCount: true,
          isActive: true,
        },
        skip: (pageNum - 1) * limitNum,
        take: limitNum,
        orderBy: [
          { isBOGOEligible: 'desc' },
          { name: 'asc' },
        ],
      }),
      prisma.product.count({ where }),
    ]);

    res.json({
      success: true,
      data: products,
      pagination: {
        page: pageNum,
        limit: limitNum,
        total,
        totalPages: Math.ceil(total / limitNum),
      },
    });
  } catch (error) {
    next(error);
  }
};

// ============================================================
// ADMIN: Toggle BOGO Eligibility on a Product
// ============================================================
export const updateProductBOGO = async (
  req: AuthRequest,
  res: Response,
  next: NextFunction,
) => {
  try {
    const { id } = req.params;
    const { isBOGOEligible, bogoPriceTier, bogoCategory } = req.body;

    const product = await prisma.product.findUnique({ where: { id } });
    if (!product) {
      res.status(404).json({ success: false, message: 'Product not found' });
      return;
    }

    // Build update data
    const updateData: any = {};
    if (isBOGOEligible !== undefined) {
      updateData.isBOGOEligible = isBOGOEligible;
    }
    if (bogoPriceTier !== undefined) {
      updateData.bogoPriceTier = bogoPriceTier;
    }
    if (bogoCategory !== undefined) {
      updateData.bogoCategory = bogoCategory;
    }

    // If disabling BOGO, clear tier and category
    if (isBOGOEligible === false) {
      updateData.bogoPriceTier = null;
      updateData.bogoCategory = null;
    }

    const updatedProduct = await prisma.product.update({
      where: { id },
      data: updateData,
      select: {
        id: true,
        name: true,
        slug: true,
        price: true,
        finalPrice: true,
        image: true,
        isBOGOEligible: true,
        bogoCategory: true,
        bogoPriceTier: true,
        stockQuantity: true,
      },
    });

    res.json({
      success: true,
      data: updatedProduct,
      message: `Product BOGO status updated`,
    });
  } catch (error) {
    next(error);
  }
};

// ============================================================
// ADMIN: BOGO Campaign Statistics
// ============================================================
export const getBOGOStats = async (
  req: AuthRequest,
  res: Response,
  next: NextFunction,
) => {
  try {
    // Get all products with BOGO status
    const [allProducts, eligibleProducts] = await Promise.all([
      prisma.product.count(),
      prisma.product.findMany({
        where: { isBOGOEligible: true },
        select: {
          bogoPriceTier: true,
          bogoCategory: true,
        },
      }),
    ]);

    const tierCounts: Record<number, number> = {};
    const categoryCounts: Record<string, number> = {};

    eligibleProducts.forEach((p) => {
      if (p.bogoPriceTier) {
        tierCounts[p.bogoPriceTier] = (tierCounts[p.bogoPriceTier] || 0) + 1;
      }
      if (p.bogoCategory) {
        categoryCounts[p.bogoCategory] = (categoryCounts[p.bogoCategory] || 0) + 1;
      }
    });

    res.json({
      success: true,
      data: {
        totalProducts: allProducts,
        totalEligibleProducts: eligibleProducts.length,
        totalUsageCount: campaignState.totalUsageCount,
        discountType: campaignState.discountType,
        tierBreakdown: tierCounts,
        categoryBreakdown: categoryCounts,
      },
    });
  } catch (error) {
    next(error);
  }
};

// ============================================================
// PUBLIC: List BOGO-Eligible Products (for storefront)
// ============================================================
export const getBogoEligibleProducts = async (
  req: AuthRequest,
  res: Response,
  next: NextFunction,
) => {
  try {
    const { tier, category } = req.query as Record<string, string>;

    // Only return products where BOGO is eligible & campaign is active
    let data = productsState.filter((p) => p.isBOGOEligible && p.isActive);

    if (tier) {
      const tierNum = parseInt(tier);
      data = data.filter((p) => p.bogoPriceTier === tierNum);
    }

    if (category && category !== 'all') {
      data = data.filter((p) => p.bogoCategory === category);
    }

    res.json({
      success: true,
      data,
      campaign: {
        active: campaignState.isActive,
        discountType: campaignState.discountType,
        discountValue: campaignState.discountValue,
      },
    });
  } catch (error) {
    next(error);
  }
};

// ============================================================
// PUBLIC: Validate BOGO Pair at Checkout
// ============================================================
export const validateBOGOCheckout = async (
  req: AuthRequest,
  res: Response,
  next: NextFunction,
) => {
  try {
    const { productId1, productId2 } = req.body;

    if (!productId1 || !productId2) {
      res.status(400).json({
        success: false,
        message: 'Two product IDs are required for BOGO validation',
      });
      return;
    }

    if (productId1 === productId2) {
      res.status(400).json({
        success: false,
        message: 'BOGO requires two different products',
      });
      return;
    }

    // Check campaign active
    if (!campaignState.isActive) {
      res.status(400).json({
        success: false,
        message: 'BOGO campaign is not currently active',
      });
      return;
    }

    const product1 = productsState.find((p) => p.id === productId1);
    const product2 = productsState.find((p) => p.id === productId2);

    if (!product1 || !product2) {
      res.status(404).json({
        success: false,
        message: 'One or both products not found',
      });
      return;
    }

    // Both must be BOGO-eligible
    if (!product1.isBOGOEligible || !product2.isBOGOEligible) {
      res.status(400).json({
        success: false,
        message: 'Both products must be BOGO-eligible',
      });
      return;
    }

    // Both must be in the same price tier
    if (product1.bogoPriceTier !== product2.bogoPriceTier) {
      res.status(400).json({
        success: false,
        message: 'Both products must be in the same price tier',
      });
      return;
    }

    // Both must be in stock
    if (product1.stockQuantity < 1 || product2.stockQuantity < 1) {
      res.status(400).json({
        success: false,
        message: 'One or both products are out of stock',
      });
      return;
    }

    // Calculate discount
    const cheaper = product1.finalPrice <= product2.finalPrice ? product1 : product2;
    const expensive = product1.finalPrice > product2.finalPrice ? product1 : product2;
    let discountAmount = 0;

    if (campaignState.discountType === 'FREE_CHEAPER') {
      discountAmount = cheaper.finalPrice;
    } else if (campaignState.discountType === 'PERCENT') {
      discountAmount = Math.round(cheaper.finalPrice * (campaignState.discountValue / 100));
    } else if (campaignState.discountType === 'FIXED') {
      discountAmount = Math.min(campaignState.discountValue, cheaper.finalPrice);
    }

    const totalBeforeDiscount = product1.finalPrice + product2.finalPrice;
    const totalAfterDiscount = totalBeforeDiscount - discountAmount;

    res.json({
      success: true,
      data: {
        valid: true,
        product1: { id: product1.id, name: product1.name, price: product1.finalPrice },
        product2: { id: product2.id, name: product2.name, price: product2.finalPrice },
        freeItem: { id: cheaper.id, name: cheaper.name },
        discountAmount,
        totalBeforeDiscount,
        totalAfterDiscount,
        savings: discountAmount,
        savingsPercent: Math.round((discountAmount / totalBeforeDiscount) * 100),
      },
    });
  } catch (error) {
    next(error);
  }
};
